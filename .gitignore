# Build output
build/
*.exe
*.obj
*.pdb
*.ilk
*.idb
*.log

# Visual Studio per-user state: window layout, breakpoints, the IntelliSense
# database. Machine-specific and regenerated on open.
.vs/
*.vcxproj.user

# graphify working files. The graph itself (graph.html, graph.json,
# GRAPH_REPORT.md) is kept - only the extraction cache and the local
# interpreter/scan paths are ignored.
graphify-out/cache/
graphify-out/.graphify_*
